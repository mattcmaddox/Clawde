# Clawde ACP TCP Server — systemd service unit
# ===============================================
#
# Place this file at:
#   /etc/systemd/system/clawde-acp.service   (system-wide)
#   ~/.config/systemd/user/clawde-acp.service (per-user)
#
# Then:
#   sudo systemctl daemon-reload
#   sudo systemctl enable clawde-acp
#   sudo systemctl start clawde-acp
#
# For per-user (user-level) services (no sudo needed):
#   systemctl --user daemon-reload
#   systemctl --user enable clawde-acp
#   systemctl --user start clawde-acp
#
# View logs:  sudo journalctl -u clawde-acp -f
# Restart:    sudo systemctl restart clawde-acp
# Status:     sudo systemctl status clawde-acp

[Unit]
Description=Clawde ACP AI Coding Agent Server
Documentation=https://github.com/user/clawde
After=network-online.target
Wants=network-online.target

[Service]
# -- Path to the clawde binary (update to match your install) ---------------
# This example is localhost-only. For LAN access, use TLS plus an
# authenticated tunnel/reverse proxy and change the bind address deliberately.
ExecStart=/usr/local/bin/clawde acp --listen 127.0.0.1:9876

# Use a dedicated profile when this endpoint should run local Ollama instead
# of inheriting your normal Free Mode credentials:
# Environment=CLAWDE_HOME=/home/user/.clawde/ollama-acp

# -- User to run as (read your ~/.clawde/auth.json for provider keys) -------
User=user
Group=user

# -- Working directory (used by tools like Read, Glob, Bash) ----------------
WorkingDirectory=/home/user

# -- Environment (API keys are read from ~/.clawde/auth.json by default) ----
# If you prefer env vars instead of auth.json, uncomment:
# Environment=ANTHROPIC_API_KEY=sk-ant-...
# Environment=GROQ_API_KEY=gsk_...

# -- Restart behaviour ------------------------------------------------------
Restart=on-failure
RestartSec=10

# -- Logging (ACP JSON-RPC goes to stdout; server logs go to stderr) -------
StandardOutput=journal
StandardError=journal

# -- Hardening (see systemd.exec(5) for details) ----------------------------
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/user
CapabilityBoundingSet=
AmbientCapabilities=

# -- Resource limits --------------------------------------------------------
LimitNOFILE=65536

# -- Timeout for graceful shutdown (systemd sends SIGTERM) ------------------
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
